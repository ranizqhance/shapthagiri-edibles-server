# ══════════════════════════════════════════════════════════════════════════
# Shapthagiri Edibles API — environment reference
#
# Copy to `.env` and fill in. Every variable the server reads is listed here
# with its default (src/config/env.ts). Empty values fall back to that default.
#
# NODE_ENV=production refuses to boot while any security-critical value below
# is missing or still a development default — see the PRODUCTION notes.
# NEVER commit a filled-in copy: `.env` and `.env.*` are git-ignored.
# ══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
# The storefront's NEXT_PUBLIC_API_BASE points here (http://localhost:9165/api/v1).
PORT=9165
API_PREFIX=/api/v1

# ─────────────────────────────── Database ───────────────────────────────
# PostgreSQL. Create the database first (`createdb shapthagiri`), then
# `npm run db:reset` builds the schema and seeds the catalogue.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# PRODUCTION: must not be "postgres".
DB_PASSWORD=
DB_NAME=shapthagiri
DB_LOGGING=false
# true = sequelize.sync() at boot (local convenience). Never in production.
DB_AUTO_SYNC=false

# ──────────────────────────────── Redis ─────────────────────────────────
# Queues (notifications), rate limiting, socket fan-out. false = in-memory
# fallbacks for a single local instance (no Redis needed).
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ───────────────────────────────── JWT ──────────────────────────────────
# PRODUCTION: two different long random strings, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ───────────────────────────────── CORS ─────────────────────────────────
# Comma-separated, exact origins the storefront is served from. The FIRST
# entry is also the base for links in outgoing email (password reset, order
# tracking), so put the real storefront first. Bare and www. forms of a
# domain are both accepted when one is listed.
CORS_ORIGINS=http://localhost:3000

# ──────────────────────── Storefront cache purge ────────────────────────
# After a product/inventory write the API POSTs here so the storefront drops
# its cached catalogue at once. The secret must equal REVALIDATE_SECRET in the
# web app's env. Leave both empty to rely on the storefront's own timer.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_SECRET=

# ──────────────────────────────── Orders ────────────────────────────────
# Minutes an unpaid online order holds its stock before it is released.
# Cash-on-delivery orders are not held — they wait for staff to confirm.
PAYMENT_HOLD_MINUTES=20
# Signs the guest order-tracking links in confirmation emails.
# PRODUCTION: required (a long random string).
ORDER_LOOKUP_SECRET=

# ──────────────────────────── Channels / limits ─────────────────────────
ENABLE_PUSH=true
ENABLE_SMS=true
ENABLE_EMAIL=true
ENABLE_RATE_LIMIT=true
# Notification throttle per user: max sends per window (seconds).
# NOTIFICATION_RATE_LIMIT_MAX=20
# NOTIFICATION_RATE_LIMIT_WINDOW=60

# ─────────────────────── Operator pages (Basic auth) ────────────────────
# Guards /api/docs and /admin/queues. PRODUCTION: not admin/admin.
DOCS_USER=admin
DOCS_PASSWORD=admin

# ─────────────────────────────── Phone OTP ──────────────────────────────
# Development only: accept fake tokens ("stub-token-+91...") so phone sign-in
# works without Firebase. The server refuses to boot with this on in production.
ALLOW_OTP_STUB=false

# ─────────────────────────── Firebase (server) ──────────────────────────
# Service account of Shapthagiri's Firebase project (Project settings →
# Service accounts → Generate new private key). Verifies the phone-OTP tokens
# the storefront gets from Firebase, and sends FCM push. Keep the private key
# on one line with literal \n sequences. Empty = phone OTP and push are off.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ───────────────────────────────── Email ────────────────────────────────
# Preferred: a Gmail account with an app password (see EMAIL-SETUP.md).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or any SMTP server (used when the Gmail pair is empty).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Shapthagiri Edibles <shapthagirirefineries@gmail.com>

# ─────────────────────────────── Payments ───────────────────────────────
# "mock" (default when PAYMENT_KEY_SECRET is empty) approves every online
# payment — for local work only. Razorpay: Dashboard → Settings → API keys.
PAYMENT_GATEWAY=mock
PAYMENT_KEY_ID=
# PRODUCTION: required.
PAYMENT_KEY_SECRET=
# A string YOU choose, typed into the Razorpay webhook (endpoint:
# https://<api-domain>/api/v1/webhooks/razorpay). PRODUCTION: required.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# ───────────────────────────────── AWS S3 ───────────────────────────────
# Uploads land under a prefix per kind. The bucket policy must allow public
# GET on products/, categories/, avatars/ and reviews/ (shown on the site) and
# keep general/, documents/, disputes/, returns/ and invoices/ private. Add the
# bucket's host to the storefront's image domains (ecommerce-web/next.config.mjs
# reads it from NEXT_PUBLIC_MEDIA_HOST).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ─────────────────────────────── PDF render ─────────────────────────────
# Invoices and statements render in headless Chromium. Optional tuning:
# PDF_MAX_CONCURRENCY=2
# PDF_MAX_WAIT_MS=45000
# PDF_SANDBOX=1   (keep Chromium's own sandbox where the host allows it)

# ──────────────────────────────── Seeding ───────────────────────────────
# `npm run db:seed` with NODE_ENV=production creates no demo logins; it
# creates this administrator instead (password at least 12 characters).
# Remove both once the account exists.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
