{
  "name": "multishop-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Shreshtam (The Taste of Valluvanad) e-commerce backend on the white-label multi-shop platform — NestJS + Sequelize + TypeScript",
  "scripts": {
    "prebuild": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "build": "nest build && tsc-alias -p tsconfig.json",
    "start": "npm run build && kill-port 4000 && node dist/main.js",
    "start:dev": "nodemon",
    "startlocal": "nodemon",
    "start:prod": "kill-port 4000 && node dist/main.js",
    "db:sync": "ts-node -r tsconfig-paths/register src/scripts/sync-db.ts",
    "db:sync:alter": "ts-node -r tsconfig-paths/register src/scripts/sync-db.ts --alter",
    "db:sync:force": "ts-node -r tsconfig-paths/register src/scripts/sync-db.ts --force",
    "db:seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "db:reset": "npm run db:sync:force && npm run db:seed",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@bull-board/express": "^8.0.1",
    "@bull-board/nestjs": "^8.0.1",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/compression": "^1.8.1",
    "@types/node-cache": "^4.1.3",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.80.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "firebase-admin": "^12.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^25.3.0",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@playwright/test": "^1.61.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^6.4.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.7",
    "playwright": "^1.61.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
